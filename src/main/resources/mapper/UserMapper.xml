<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zqp.mapper.UserMapper">

    <select id="selectUserById" resultType="com.zqp.entity.User">
        SELECT id,username,phone,email,create_time,update_time
        FROM user
        WHERE id = #{id}
    </select>

    <insert id="insertUser">
        INSERT INTO user(username,phone,email)
        VALUES(#{username},#{phone},#{email})
    </insert>

    <update id="updateUser">
        UPDATE user
        SET username=#{username},phone=#{phone},email=#{email}
        WHERE id=#{id}
    </update>

    <delete id="deleteUserById">
        DELETE FROM user WHERE id = #{id}
    </delete>

    <select id="selectUserList" resultType="com.zqp.entity.User">
        SELECT id,username,phone,email,create_time,update_time FROM user
    </select>

</mapper>